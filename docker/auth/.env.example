PORT=8000
JWT_SECRET=YOUR_JWT_SECRET_MIN_64_CHARS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Production: set to your public-facing shell URL (e.g. https://ordeck.yourdomain.com)
SHELL_URL=https://YOUR_SHELL_DOMAIN
# Production: set to your public-facing auth URL (e.g. https://auth.yourdomain.com or same host + /api/auth)
AUTH_URL=https://YOUR_AUTH_DOMAIN
# Comma-separated list of allowed Google emails. Leave empty to allow any Google account.
ALLOWED_EMAILS=
DB_PATH=/data/auth.db
NODE_ENV=production
