# ORDECK nginx path overrides
# On TrueNAS: leave these unset — defaults are used automatically
# Local dev:  uncomment and set to local paths

# SSL certificate directory (must contain jkos.net.crt + jkos.net.key)
# SSL_PATH=/path/to/Backends/ssl

# Nginx access/error log directory
# NGINX_LOGS_PATH=/path/to/Backends/nginx-ordeck-logs
