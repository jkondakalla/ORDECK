FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/plex-widget/ ./apps/plex-widget/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @jkhub/plex-widget build

FROM nginx:alpine
COPY --from=builder /repo/apps/plex-widget/dist /usr/share/nginx/html
EXPOSE 80
